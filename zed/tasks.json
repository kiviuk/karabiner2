// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "pytest: current file",
    "command": "uv",
    "args": ["run", "pytest", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "current"
  },
  {
    "label": "mypy: current file",
    "command": "uv",
    "args": ["run", "mypy", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
